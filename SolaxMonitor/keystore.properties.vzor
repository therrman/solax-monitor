# Zkopíruj na keystore.properties a doplň heslo a alias.
# Tenhle soubor obsahuje heslo ke klíči - nikam ho nenahrávej a nesdílej.
#
# Alias zjistíš příkazem:
#   keytool -list -keystore /Users/tomas.herrman/tom/tom-release-key.jks
#
# Když je heslo ke klíči stejné jako ke keystoru (běžné), vyplň obě stejně.

storeFile=/Users/tomas.herrman/tom/tom-release-key.jks
storePassword=
keyAlias=
keyPassword=
